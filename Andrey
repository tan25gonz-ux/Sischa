<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Control Admin - Monitoreo en Tiempo Real</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --primary: #4f46e5;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
            --gray-900: #111827;
            --radius: 16px;
            --shadow: 0 4px 6px -1px rgba(0,0,0,0.07);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.08);
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            background-image: radial-gradient(at 0% 0%, rgba(79, 70, 229, 0.06) 0px, transparent 50%),
                              radial-gradient(at 100% 0%, rgba(14, 165, 233, 0.06) 0px, transparent 50%);
            color: var(--gray-800);
            padding: 20px;
            min-height: 100vh;
        }

        .app-container { max-width: 1200px; margin: 0 auto; }

        /* HEADER */
        .header-panel {
            background: linear-gradient(135deg, var(--primary) 0%, #8b5cf6 100%);
            padding: 24px 32px;
            border-radius: var(--radius);
            box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.35);
            margin-bottom: 24px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header-panel h2 { font-size: 24px; font-weight: 800; margin: 0; }
        .header-panel small { font-size: 14px; opacity: 0.9; }

        /* GRID */
        .grid-cajas {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 20px;
        }

        /* CARD SUCURSAL */
        .card-caja {
            background: white;
            padding: 24px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--gray-200);
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card-caja:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
        
        .card-caja::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--primary), #8b5cf6);
        }

        .badge-live {
            background: #ecfdf5;
            color: #065f46;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .dot {
            width: 8px; height: 8px;
            background: #10b981;
            border-radius: 50%;
            animation: blink 1.5s infinite;
        }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

        .monto-vivo {
            font-size: 32px;
            font-weight: 800;
            color: #065f46;
            margin: 12px 0 16px;
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
            padding: 16px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #a7f3d0;
        }

        .detalle-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px dashed var(--gray-200);
            font-size: 13px;
            color: var(--gray-600);
            font-weight: 600;
        }
        .detalle-item:last-child { border-bottom: none; }
        
        .monto-pos { color: #059669; font-weight: 800; }
        .monto-neg { color: #dc2626; font-weight: 800; }

        /* BOTONERA */
        .actions-box {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }
        .btn-inyectar {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s;
            box-shadow: 0 4px 10px -2px rgba(16, 185, 129, 0.4);
        }
        .btn-inyectar:hover { transform: translateY(-1px); box-shadow: 0 6px 15px -2px rgba(16, 185, 129, 0.5); }

        /* MODAL */
        .modal-overlay {
            position: fixed; inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }
        .modal-overlay.active { display: flex; }
        .modal-box {
            background: white;
            border-radius: 20px;
            padding: 28px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
            animation: slideUp 0.3s ease-out;
        }
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        
        .modal-box h3 { margin-bottom: 16px; color: var(--gray-900); font-size: 20px; }
        .modal-box label { font-size: 13px; font-weight: 700; color: var(--gray-600); display: block; margin-bottom: 6px; }
        .modal-box input {
            width: 100%; padding: 12px 14px;
            border: 1.5px solid var(--gray-200);
            border-radius: 8px; font-size: 14px;
            font-family: inherit; margin-bottom: 16px;
            transition: all 0.15s;
        }
        .modal-box input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1); }
        
        .modal-buttons { display: flex; gap: 10px; }
        .btn-cancel { background: var(--gray-100); color: var(--gray-600); border: none; padding: 12px; border-radius: 8px; font-weight: 700; cursor: pointer; flex: 1; }
        .btn-confirm { background: var(--primary); color: white; border: none; padding: 12px; border-radius: 8px; font-weight: 700; cursor: pointer; flex: 1; }
    </style>
</head>
<body>

    <div class="app-container">
        <div class="header-panel">
            <div>
                <h2>🔴 Panel de Administración</h2>
                <small>Monitoreo de cajas y arqueos en tiempo real</small>
            </div>
        </div>

        <div id="contenedor-cajas" class="grid-cajas">
            <p style="color:var(--gray-600); font-weight: 600;">Cargando cajas de sucursales en vivo...</p>
        </div>
    </div>

    <!-- MODAL PARA INYECTAR DINERO -->
    <div id="modal-inyectar" class="modal-overlay">
        <div class="modal-box">
            <h3>💸 Inyectar Dinero</h3>
            <p style="font-size:13px; color:var(--gray-600); margin-bottom:16px;">
                Enviar dinero a la sucursal <b id="modal-sucursal-nombre"></b>. Se sumará como "Plata Agregada".
            </p>
            
            <label>Monto a enviar (₡)</label>
            <input type="text" id="input-monto-inyectar" placeholder="Ej: 50 000" oninput="formatearMoneda(this)">
            
            <label>Motivo / Detalle</label>
            <input type="text" id="input-motivo-inyectar" placeholder="Ej: Envío de administración">

            <div class="modal-buttons">
                <button class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
                <button class="btn-confirm" onclick="confirmarInyeccion()">💾 Enviar Dinero</button>
            </div>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, onSnapshot, doc, updateDoc, increment, arrayUnion } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCi409CkmXBbun7-POejbVaIiThK2nZ1JY",
            authDomain: "prestamos-18dd8.firebaseapp.com",
            projectId: "prestamos-18dd8",
            storageBucket: "prestamos-18dd8.firebasestorage.app",
            messagingSenderId: "921713515466",
            appId: "1:921713515466:web:0e2bcb5d67067068570d33"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        let sucursalSeleccionada = "";
        let montoAInyectar = 0;

        // --- ESCUCHADOR EN TIEMPO REAL ---
        onSnapshot(collection(db, "cajas_en_vivo"), (snapshot) => {
            const contenedor = document.getElementById('contenedor-cajas');
            contenedor.innerHTML = "";

            if (snapshot.empty) {
                contenedor.innerHTML = "<p style='color:var(--gray-600);'>No hay cajas activas registradas en este momento.</p>";
                return;
            }

            snapshot.forEach((documento) => {
                const data = documento.data();
                const hora = data.ultima_actualizacion ? new Date(data.ultima_actualizacion.toDate()).toLocaleTimeString() : 'En espera';

                contenedor.innerHTML += `
                    <div class="card-caja">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <h3 style="margin:0; color:var(--gray-900);">📍 ${data.sucursal}</h3>
                            <span class="badge-live"><span class="dot"></span> ${hora}</span>
                        </div>

                        <label style="font-size:12px; color:var(--gray-600); font-weight:800; display:block; margin-top:16px; text-transform:uppercase; letter-spacing:0.5px;">Caja Disponible Actual</label>
                        <div class="monto-vivo">₡${(data.caja_disponible || 0).toLocaleString('es-CR')}</div>
                        
                        <div>
                            <div class="detalle-item">
                                <span>📥 Base Inicio:</span>
                                <span>₡${(data.caja_inicio || 0).toLocaleString('es-CR')}</span>
                            </div>
                            <div class="detalle-item">
                                <span>➕ Plata Agregada / Depósitos:</span>
                                <span class="monto-pos">+₡${(data.depositos || 0).toLocaleString('es-CR')}</span>
                            </div>
                            <div class="detalle-item">
                                <span>➕ Ventas Registradas:</span>
                                <span class="monto-pos">+₡${(data.ventas || 0).toLocaleString('es-CR')}</span>
                            </div>
                            <div class="detalle-item">
                                <span>➖ Pagado en Facturas:</span>
                                <span class="monto-neg">-₡${(data.compras_facturas || 0).toLocaleString('es-CR')}</span>
                            </div>
                            <div class="detalle-item">
                                <span>➖ Gastos Varios:</span>
                                <span class="monto-neg">-₡${(data.gastos || 0).toLocaleString('es-CR')}</span>
                            </div>
                        </div>

                        <div class="actions-box">
                            <button class="btn-inyectar" onclick="abrirModal('${data.sucursal}')">
                                💸 Inyectar Dinero
                            </button>
                        </div>
                    </div>
                `;
            });
        });

        // --- LÓGICA DEL MODAL ---
        window.abrirModal = function(sucursal) {
            sucursalSeleccionada = sucursal;
            document.getElementById('modal-sucursal-nombre').innerText = sucursal;
            document.getElementById('input-monto-inyectar').value = '';
            document.getElementById('input-motivo-inyectar').value = '';
            document.getElementById('modal-inyectar').classList.add('active');
        };

        window.cerrarModal = function() {
            document.getElementById('modal-inyectar').classList.remove('active');
            sucursalSeleccionada = "";
            montoAInyectar = 0;
        };

        window.formatearMoneda = function(input) {
            let valor = input.value.replace(/\D/g, "");
            if (valor) input.value = Number(valor).toLocaleString('es-CR');
            else input.value = "";
            montoAInyectar = Number(valor) || 0;
        };

        window.confirmarInyeccion = async function() {
            const motivo = document.getElementById('input-motivo-inyectar').value.trim();
            
            if (montoAInyectar <= 0) {
                alert("⚠️ Por favor, ingrese un monto válido.");
                return;
            }

            const btn = document.querySelector('.btn-confirm');
            btn.disabled = true; btn.innerText = "⏳ Enviando...";

            try {
                const cajaRef = doc(db, "cajas_en_vivo", sucursalSeleccionada);
                
                // Actualizamos Firebase sumando el dinero a los depósitos
                await updateDoc(cajaRef, {
                    depositos: increment(montoAInyectar),
                    caja_disponible: increment(montoAInyectar),
                    admin_envios: arrayUnion({
                        monto: montoAInyectar,
                        motivo: motivo || "Envío de administración",
                        fecha: new Date().toISOString()
                    })
                });

                alert(`✅ Se enviaron ₡${montoAInyectar.toLocaleString('es-CR')} a la sucursal ${sucursalSeleccionada}.\n\n(La sucursal debe recargar o sincronizar para verlo reflejado).`);
                cerrarModal();
            } catch (error) {
                console.error(error);
                alert("❌ Error al inyectar dinero: " + error.message);
            } finally {
                btn.disabled = false; btn.innerText = "💾 Enviar Dinero";
            }
        };
    </script>
</body>
</html>
